# Copy this file to .env and fill in your own values. Never commit .env.

# --- Credentials (placeholders only) ---
API_KEY=your-gemini-api-key-here
HF_TOKEN=your-huggingface-token-here

# --- Optional: image provider (default: huggingface) ---
# IMAGE_PROVIDER=huggingface

# --- Usage limits (values shown are the defaults) ---
GENERATION_ENABLED=true
MAX_PROMPTS_PER_REQUEST=10
MAX_IMAGES_PER_REQUEST=2
MAX_CONCEPT_LENGTH=500
MAX_IMAGE_PROMPT_LENGTH=2000
MAX_GENERATION_REQUESTS_PER_MINUTE=3
MAX_IMAGES_PER_DAY=5
QUOTA_TIMEZONE=Asia/Jerusalem

# --- Gemini (free tier): request caps, no spending ---
GEMINI_MAX_REQUESTS_PER_MINUTE=5
GEMINI_MAX_REQUESTS_PER_DAY=50

# --- Hugging Face (prepaid credits): application-side budget in USD ---
HF_MONTHLY_BUDGET_USD=4.75
HF_BUDGET_SAFETY_MARGIN_PERCENT=10
