# Copy this file to .env and fill in your own values. Never commit .env.

# --- Credentials (placeholders only) ---
API_KEY=your-gemini-api-key-here
HF_TOKEN=your-huggingface-token-here

# --- Optional: image provider (default: huggingface) ---
# IMAGE_PROVIDER=huggingface

# --- Usage limits (values shown are the defaults) ---
GENERATION_ENABLED=true
MAX_PROMPTS_PER_REQUEST=10
MAX_IMAGES_PER_REQUEST=2
MAX_CONCEPT_LENGTH=500
MAX_IMAGE_PROMPT_LENGTH=2000
MAX_GENERATION_REQUESTS_PER_MINUTE=3
MAX_IMAGES_PER_DAY=5
QUOTA_TIMEZONE=Asia/Jerusalem
USAGE_DB_PATH=usage.db

# A request left "pending" with no activity this long (seconds) is treated as abandoned by a crash.
# Must be at least 240: twice the longest provider timeout (HF 120 s), so a slow call is never mistaken for a crash.
STALE_REQUEST_SECONDS=900

# --- Gemini (free tier): request caps, no spending ---
GEMINI_PLAN=free
GEMINI_MAX_REQUESTS_PER_MINUTE=5
GEMINI_MAX_REQUESTS_PER_DAY=50

# --- Hugging Face (prepaid credits): application-side budget in USD ---
# How the budget is counted. Switching modes never deletes usage history. Restart the app after changing it.
#   cumulative (default): HF_BUDGET_USD is the TOTAL you track, e.g. your remaining credit. All recorded
#                         spending counts and nothing ever resets. 4.75 with a 10% margin -> $4.275 usable.
#   monthly:              HF_BUDGET_USD is the allowance PER CALENDAR MONTH. Only spending since 00:00 on the
#                         1st (QUOTA_TIMEZONE, Asia/Jerusalem) counts, and it resets by itself. 5 with a 10%
#                         margin -> $4.50 usable per month. HF_BUDGET_USD must be written explicitly.
HF_BUDGET_MODE=cumulative
# If you add credits, raise HF_BUDGET_USD yourself. Put the FULL amount here: the margin below is applied for you.
HF_BUDGET_USD=4.75
HF_BUDGET_SAFETY_MARGIN_PERCENT=10
# REQUIRED for image generation: your estimate of what ONE Hugging Face image call costs in USD
# (retries and failed calls are charged at the same price). Look it up on your provider's pricing
# page; the app does not guess. Uncomment and set it; images are refused until it is set.
# HF_COST_PER_IMAGE_USD=
